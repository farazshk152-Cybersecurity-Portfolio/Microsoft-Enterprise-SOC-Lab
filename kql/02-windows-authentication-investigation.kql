//
// Microsoft Enterprise SOC Lab
// Query: Windows Authentication Investigation
// Purpose: Investigate successful and failed Windows logons,
//          including accounts, logon types, and source IP addresses.
// Event IDs:
//   4624 = Successful logon
//   4625 = Failed logon
// Data Source: SecurityEvent
//

SecurityEvent
| where TimeGenerated > ago(24h)
| where Computer =~ "LAPTOP-JM2CHLK8"
| where EventID in (4624, 4625)
| project TimeGenerated, Computer, EventID, Activity, Account, LogonType, LogonTypeName, IpAddress
| order by TimeGenerated desc
| take 50
