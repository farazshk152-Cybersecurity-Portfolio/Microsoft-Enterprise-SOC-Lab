//
// Microsoft Enterprise SOC Lab
// Query: Incident Timeline Reconstruction
// Purpose: Reconstruct important Windows security activity around
//          an incident for investigation and evidence review.
//

SecurityEvent
| where Computer =~ "LAPTOP-JM2CHLK8"
| where EventID in (4624, 4625, 4672, 4688, 4720, 4722, 4725, 4726, 4728, 4732, 4756, 4798, 4799, 1102)
| extend EventCategory = case(
    EventID == 4624, "Successful Logon",
    EventID == 4625, "Failed Logon",
    EventID == 4672, "Privileged Logon",
    EventID == 4688, "Process Creation",
    EventID == 4720, "Account Created",
    EventID == 4722, "Account Enabled",
    EventID == 4725, "Account Disabled",
    EventID == 4726, "Account Deleted",
    EventID in (4728, 4732, 4756), "Group Membership Change",
    EventID == 4798, "User Group Discovery",
    EventID == 4799, "Local Group Discovery",
    EventID == 1102, "Security Audit Log Cleared",
    "Other"
)
| project TimeGenerated, Computer, EventCategory, EventID, Account, Activity
| order by TimeGenerated asc
